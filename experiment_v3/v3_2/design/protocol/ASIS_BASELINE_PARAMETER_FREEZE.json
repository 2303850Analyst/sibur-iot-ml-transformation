    "status": "SCENARIO_ASSUMPTION; if an existing frozen V3 resource roster is found, reconcile BEFORE protocol freeze; do not silently mix counts"
  },
  "measurement": {
    "primary_unit": "one inbound case with all its pallets, case_id",
    "primary_full_cycle": "t_standard_close - t_first_pallet_ready; include open cases and T72 capped horizon separately",
