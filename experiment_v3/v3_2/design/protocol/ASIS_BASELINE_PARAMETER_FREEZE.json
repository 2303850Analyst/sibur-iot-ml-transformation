  "human_factors": {
    "service_distribution": "triangular around each specified mode, 0.7x/1.0x/1.3x, with per-entity keyed random variates identical across masks for unchanged subactions",
    "context_switch_s": 8,
    "context_switch_applies": "only when the same real worker changes case/task category, once per actual change, never per arbitrary event",
    "break_schedule": "three 8-hour shifts; per-person two 10-minute short breaks and one 30-minute meal break staggered; all staff counts and calendars locked across masks",
    "reference_fatigue_rule": {
      "lookback_minutes": 120,
      "busy_fraction_threshold": 0.85,
      "manual_time_multiplier_above_threshold": 1.1,
      "manual_time_multiplier_otherwise": 1.0,
      "exclude_equipment_physical_speed": true
    },
    "predeclared_sensitivity_fatigue_multipliers": [
      1.0,
      1.1,
      1.2
    ],
    "new_spontaneous_error_probabilities": "NOT_ADDED: use frozen source data defects and scenarios S2/S3/S5; additional human error risk only as separately pre-registered sensitivity, never to engineer ROI",
    "idle_time": "Never count idle/queue as active labor; record paid shift capacity separately.",
    "employee_count_is_not_20_odoo_users": true
  },
  "staffing_reference_assumption": {
    "shift_hours": 8,
    "shifts_per_day": 3,
    "workers_per_shift": {
      "production_clerk": 1,
      "receiver": 2,
      "quality_inspector": 1,
      "wms_operator": 2,
      "forklift_driver": 2,
      "supervisor_on_exception": 1
